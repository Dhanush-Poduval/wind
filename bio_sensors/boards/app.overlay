/ {
  aliases {
    sensors14-channel = &adc1;
    sensors5-channel = &adc2;
    bio-sensor1 = &ad12_15;
    bio-sensor2 = &ad123_10;
    bio-sensor3 = &ad12_10;
    bio-sensor4 = &ad12_5;
    bio-sensor5 = &adc3_6;
    dth11-sensor= &digital_bio;
  };
  digital: digitals {
    compatible="gpio-pins";
    &digital_bio: digital_sensor{
      gpios=<&gpioc 3 GPIO_ACTIVE_LOW>;
    };
  };
};

&adc1 {
  status="okay";
  #address-cells=<1>;
  #size-cells=<0>;
  st,adc-clock-source = "SYNC";
  st,adc-prescaler=<4>;
  ad12_15: channel@f{
    reg=<15>;
    status="okay";
    zephyr,gain="ADC_GAIN_1";
    zephyr,reference="ADC_REF_INTERNAL";
    zephyr,acquisition-time=<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS,50)>;
    zephyr,resolution=<12>;
    zephyr,vref-mv=<3300>;
  };

  ad123_10: channel@a{
    reg=<10>;
    status="okay";
    zephyr,gain="ADC_GAIN_1";
    zephyr,reference="ADC_REF_INTERNAL";
    zephyr,acquisition-time=<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS,50)>;
    zephyr,resolution=<12>;
    zephyr,vref-mv=<3300>;
  };

  ad12_10: channel@d{
    reg=<13>;
    status="okay";
    zephyr,gain="ADC_GAIN_1";
    zephyr,reference="ADC_REF_INTERNAL";
    zephyr,acquisition-time=<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS,50)>;
    zephyr,resolution=<12>;
    zephyr,vref-mv=<3300>;

  };

  ad12_5: channel@5{
    reg=<5>;
    zephyr,gain="ADC_GAIN_1";
    zephyr,reference="ADC_REF_INTERNAL";
    zephyr,acquisition-time=<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS,50)>;
    zephyr,resolution=<12>;
    zephyr,vref-mv=<3300>;

  };

};

&adc2 {
  status="okay";
  #address-cells=<1>;
  #size-cells=<0>;
  st,adc-clock-source = "SYNC";
  st,adc-prescaler = <4>;
  adc3_6: channel@6{
    reg=<6>;
    zephyr,gain="ADC_GAIN_1";
    zephyr,reference="ADC_REF_INTERNAL";
    zephyr,acquisition-time=<ADC_ACQ_TIME(ADC_ACQ_TIME_MICROSECONDS,50)>;
    zephyr,resolution=<12>;
    zephyr,vref-mv=<3300>;
  };
};

&usart2 {
  status="okay";
  pinctrl-0=<&usart2_tx_pd5 &usart2_rx_pd6>;
  pinctrl-names="default";
};
